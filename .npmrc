# @langchain/community (reached only through @n8n/node-cli's AI tooling) declares
# @browserbasehq/stagehand as a required peer, and npm would auto-install it with
# openai 4 — browser automation nothing here uses. Skip peer auto-install.
# Consequence: a peer our own code needs (@types/node) must be a devDependency.
# Typecheck outside the repo to prove it — inside, tsc borrows the backend's.
legacy-peer-deps=true
